{
  "name": "Chronos",
  "version": "0.1.0",
  "description": "A crash-resilient distributed transaction & workflow orchestration engine implementing the Saga pattern",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "saga",
    "distributed-transactions",
    "workflow",
    "orchestration",
    "microservices",
    "compensation",
    "crash-recovery"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1",
    "uuid": "^11.0.3",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
